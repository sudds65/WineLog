# WineLog service configuration — installed to /etc/winelog.env
# Edit, then: sudo systemctl restart winelog

# Address uvicorn binds to.
#   0.0.0.0   reachable from the LAN/VPN (default; pair with the firewall rules)
#   127.0.0.1 local only — use this when nginx sits in front
WINELOG_HOST=0.0.0.0

# Any port, including 80 and 443: the service holds CAP_NET_BIND_SERVICE, so it
# can bind the privileged ports while still running as the winelog account.
WINELOG_PORT=8071

# Database and uploaded receipts.
WINELOG_DATA_DIR=/var/lib/winelog

# Serve HTTPS directly. Set both to a certificate and key the winelog account
# can read (the installer's --https writes them to /etc/winelog/tls and sets
# the group), or leave empty for plain HTTP.
WINELOG_TLS_CERT=
WINELOG_TLS_KEY=

# With TLS on, also answer plain HTTP on this port and redirect to HTTPS, so
# typing the bare hostname still works. 0 turns it off.
WINELOG_HTTP_REDIRECT_PORT=0

# Marks the session cookie Secure. Defaults to on when the TLS certificate
# above is set, off otherwise — only set it explicitly if TLS terminates
# somewhere else (an nginx or a load balancer in front of this app).
#WINELOG_COOKIE_SECURE=true

# How long a login lasts, in days.
WINELOG_SESSION_DAYS=30
