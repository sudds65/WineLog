[Unit]
Description=WineLog — Obscure Wine Co. membership breakeven tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=winelog
Group=winelog
WorkingDirectory=/opt/winelog

# Host, port, TLS certificate, data directory and cookie policy all live here
# so this unit never needs editing. See deploy/winelog.env.example.
EnvironmentFile=/etc/winelog.env

ExecStart=/opt/winelog/.venv/bin/python -m app.serve

Restart=on-failure
RestartSec=5

# Lets the app listen on 80/443 while still running as the unprivileged
# winelog account. Harmless on a high port, so it is granted unconditionally.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening — the app only ever needs to write its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/winelog

[Install]
WantedBy=multi-user.target
